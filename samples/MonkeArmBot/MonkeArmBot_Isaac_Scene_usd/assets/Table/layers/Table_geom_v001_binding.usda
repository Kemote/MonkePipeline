#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "Table"
{
    over "Geom"
    {
        over "wood_table" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Table/Looks/wood_table>
        }

        over "steel_frame" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Table/Looks/blackMetal>
        }
    }
}

