{
  "roots": {
    "main": "<projects_root>/<project_name>",
    "assets": "<projects_root>/<project_name>/assets"
  },
  "tokens": {
    "projects_root": {
      "type": "str"
    },
    "name": {
      "type": "str"
    },
    "step": {
      "type": "str"
    },
    "project_name": {
      "type": "str"
    },
    "ext": {
      "type": "str"
    },
    "variant": {
      "type": "str"
    },
    "variant_path": {
      "type": "str"
    }
  },
  "templates": {
    "world_main_file": {
      "template": "/<project_name>.<ext>",
      "root": "main"
    },
    "asset_main_file": {
      "template": "/<name>/<name>.<ext>",
      "root": "assets"
    },
    "asset_sublayer_file": {
      "template": "/<name>/layers/<name>_<step>_<version>.<ext>",
      "root": "assets"
    },
    "asset_mesh_variants_output": {
      "template": "/<name>/layers/mesh_variants",
      "root": "assets"
    },
    "asset_mesh_variant_layer": {
      "template": "/<name>/layers/mesh_variants/<variant_path>/<variant>_<version>.<ext>",
      "root": "assets"
    },
    "asset_textures_output": {
      "template": "/<name>/textures",
      "root": "assets"
    }
  }
}