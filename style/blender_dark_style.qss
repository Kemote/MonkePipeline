/* Qt stylesheet approximating Blender's default dark theme, used by the
   PySide6 dialogs in blender_exporter_ui.py. */

QDialog {
    background-color: #303030;
    color: #dcdcdc;
}

QLabel {
    color: #dcdcdc;
    background: transparent;
}

QLineEdit {
    background-color: #232323;
    color: #dcdcdc;
    border: 1px solid #191919;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #5680c2;
}

QLineEdit:focus {
    border: 1px solid #5680c2;
}

QPlainTextEdit {
    background-color: #232323;
    color: #dcdcdc;
    border: 1px solid #191919;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #5680c2;
}

QPlainTextEdit:focus {
    border: 1px solid #5680c2;
}

QPushButton {
    background-color: #4a4a4a;
    color: #dcdcdc;
    border: 1px solid #191919;
    border-radius: 3px;
    padding: 5px 14px;
}

QComboBox {
    background-color: #4a4a4a;
    color: #dcdcdc;
    border: 1px solid #191919;
    border-radius: 3px;
    padding: 5px 14px;
}

/* the popup's own outer frame (QComboBoxPrivateContainer, a plain QFrame) is
   a separate widget from the QAbstractItemView it wraps - without this it
   keeps its default light border regardless of the rule above */
QComboBox QFrame {
    background-color: #3c3c3c;
    border: 1px solid #191919;
}

QComboBox QAbstractItemView {
    background-color: #3c3c3c;
    color: #dcdcdc;
    border: 1px solid #191919;
    outline: none;
    selection-background-color: #5680c2;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    padding: 4px 6px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #4a4a4a;
}


QPushButton:hover {
    background-color: #5a5a5a;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QPushButton:default {
    background-color: #5680c2;
    border: 1px solid #3d5f8f;
    color: #ffffff;
}

QPushButton:default:hover {
    background-color: #6690d2;
}

QCheckBox {
    color: #dcdcdc;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #191919;
    border-radius: 3px;
    background-color: #232323;
}

QCheckBox::indicator:checked {
    background-color: #5680c2;
    border: 1px solid #3d5f8f;
}

QCheckBox::indicator:hover {
    border: 1px solid #5680c2;
}
