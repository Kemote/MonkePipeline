# Monke Pipeline environment defaults.
# Copy this file to `pipeline.env` and adjust paths for your machine.
# `pipeline.env` is gitignored - it holds machine-specific paths, `pipeline.env.example`
# stays checked in as the template. A future launcher can source/inject the same
# keys directly instead of reading this file.

# project identity
PROJECTNAME=sample_usd_files
PROJECTSROOT=/home/kemot/Documents/Dev/MonkePipeline
MONKENAME="Name Surname"

# USD environment
LD_LIBRARY_PATH=/home/kemot/USD/lib

# asset resolver plugin build, one per host application
PXR_PLUGINPATH_NAME_BLENDER=/home/kemot/Documents/Dev/MonkePipeline/usd_asset_resolver/build
PXR_PLUGINPATH_NAME_OMNIVERSE=/home/kemot/Documents/Dev/MonkePipeline/usd_asset_resolver/build_kit
PXR_PLUGINPATH_NAME_USDVIEW=/home/kemot/Documents/Dev/MonkePipeline/usd_asset_resolver/build

# Blender launcher
BLENDER_FLATPAK_APP_ID=org.blender.Blender
MONKE_SITE_PACKAGES=/home/kemot/Documents/Dev/_VENVS/python-usd-venv/lib/python3.12/site-packages

# usdview launcher
QT_QPA_PLATFORM=xcb
USDVIEW_LAUNCHER=/home/kemot/UsdRoot/scripts/usdview_gui.sh

# Omniverse Kit launcher
OMNIVERSE_KIT_LAUNCHER=/home/kemot/kit-app-template/repo.sh
OMNIVERSE_KIT_APP=kemot.usd_explorer.kit
