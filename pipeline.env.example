# Monke Pipeline environment defaults.
# Copy this file to `pipeline.env` and adjust paths for your machine.
# `pipeline.env` is gitignored - it holds machine-specific paths, `pipeline.env.example`
# stays checked in as the template. A future launcher can source/inject the same
# keys directly instead of reading this file.

# project identity
# Optional. When set, they override the output folder in the export dialog
# (PROJECTSROOT/PROJECTNAME) and are required by the monkeDisc:// resolver.
# Leave them empty to export into "<blend name>_usd" next to the .blend file.
PROJECTNAME=
PROJECTSROOT=
MONKENAME="Name Surname"

# USD environment, only needed for the monkeDisc:// resolver plugin
LD_LIBRARY_PATH=/path/to/OpenUSD/lib

# asset resolver plugin build, one per host application
PXR_PLUGINPATH_NAME_BLENDER=/path/to/MonkePipeline/usd_asset_resolver/build
PXR_PLUGINPATH_NAME_OMNIVERSE=/path/to/MonkePipeline/usd_asset_resolver/build_kit
PXR_PLUGINPATH_NAME_USDVIEW=/path/to/MonkePipeline/usd_asset_resolver/build

# Blender launcher
BLENDER_FLATPAK_APP_ID=org.blender.Blender
# a site-packages folder with PySide6 built for Blender's Python (3.13 for Blender 5.x)
PYSIDE6_SITE_PACKAGES=/path/to/site-packages

# xcb runs the Qt dialogs through XWayland, so they stay on top on Wayland
QT_QPA_PLATFORM=xcb
