#usda 1.0
(
    customLayerData = {
        string userName = "Name Surname"
    }
    defaultPrim = "roboticArm"
    framesPerSecond = 30
    metersPerUnit = 1
    subLayers = [
        @monkeDisc://assets/roboticArm/layers/roboticArm_geom_<version>.usda:latest@,
        @monkeDisc://assets/roboticArm/layers/roboticArm_look_<version>.usda:latest@,
        @monkeDisc://assets/roboticArm/layers/roboticArm_rig_<version>.usda:latest@
    ]
    timeCodesPerSecond = 30
    upAxis = "Z"
)

over "roboticArm" (
    kind = "component"
)
{
}

