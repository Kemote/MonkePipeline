#usda 1.0
(
    framesPerSecond = 30
    metersPerUnit = 1
    timeCodesPerSecond = 30
)

def "roboticArm" (
    variants = {
        string endEffector = "handle"
        string mainColor = "green"
    }
    prepend variantSets = ["endEffector", "mainColor"]
)
{
    def Xform "SkelRoot" (
        prepend references = [
            @mesh_variants/lod/render_v001.usda@,
            @mesh_variants/lod/proxy_v001.usda@
        ]
    )
    {
        def Scope "Geom"
        {
        }
    }
    variantSet "endEffector" = {
        "handle" {
            over "SkelRoot" (
                variants = {
                    string endEffector = "handle"
                }
                prepend variantSets = "endEffector"
            )
            {
            }

        }
        "velding" {
            over "SkelRoot" (
                variants = {
                    string endEffector = "velding"
                }
                prepend variantSets = "endEffector"
            )
            {
            }

        }
    }
    variantSet "mainColor" = {
        "green" {
            over "SkelRoot" (
                variants = {
                    string mainColor = "green"
                }
                prepend variantSets = "mainColor"
            )
            {
            }

        }
        "red" {
            over "SkelRoot" (
                variants = {
                    string mainColor = "red"
                }
                prepend variantSets = "mainColor"
            )
            {
            }

        }
        "yellow" {
            over "SkelRoot" (
                variants = {
                    string mainColor = "yellow"
                }
                prepend variantSets = "mainColor"
            )
            {
            }

        }
    }
}

