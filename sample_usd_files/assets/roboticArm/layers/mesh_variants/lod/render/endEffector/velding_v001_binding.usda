#usda 1.0

over "roboticArm"
{
    over "Geom"
    {
        over "render"
        {
            over "weldingBox" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </roboticArm/Looks/secColor>
            }

            over "weldingEnd" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </roboticArm/Looks/welder_metal>
            }
        }
    }
}

