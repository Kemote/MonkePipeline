#usda 1.0
(
    framesPerSecond = 30
    timeCodesPerSecond = 30
)

def "roboticArm"
{
    def Scope "Looks"
    {
        def Material "secColor"
        {
            token outputs:surface.connect = </roboticArm/Looks/secColor/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.15515924, 0.15515924, 0.15515924)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness.connect = </roboticArm/Looks/secColor/rusted_metal_26_69_glossiness_jpg_Texture.outputs:r>
                token outputs:surface
            }

            def Shader "rusted_metal_26_69_glossiness_jpg_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/rusted_metal_26_69_glossiness.jpg@
                float2 inputs:st.connect = </roboticArm/Looks/secColor/uvReader_st.outputs:result>
                float outputs:r
            }

            def Shader "uvReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "engineRed"
        {
            token outputs:surface.connect = </roboticArm/Looks/engineRed/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.80000746, 0, 0.0019808419)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "welder_metal"
        {
            token outputs:surface.connect = </roboticArm/Looks/welder_metal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </roboticArm/Looks/welder_metal/welder_png_Texture.outputs:rgb>
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0.7004104
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "welder_png_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/welder.png@
                float2 inputs:st.connect = </roboticArm/Looks/welder_metal/uvReader_st.outputs:result>
                float3 outputs:rgb
            }

            def Shader "uvReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </roboticArm/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.04020722, 0.04020722, 0.04020722)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.880301
                token outputs:surface
            }
        }

        def Material "mainColor_red"
        {
            token outputs:surface.connect = </roboticArm/Looks/mainColor_red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.80000746, 0, 0.023635123)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness.connect = </roboticArm/Looks/mainColor_red/rusted_metal_26_69_glossiness_jpg_Texture.outputs:r>
                token outputs:surface
            }

            def Shader "rusted_metal_26_69_glossiness_jpg_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/rusted_metal_26_69_glossiness.jpg@
                float2 inputs:st.connect = </roboticArm/Looks/mainColor_red/uvReader_st.outputs:result>
                float outputs:r
            }

            def Shader "uvReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

        def Material "mainColor_yellow"
        {
            token outputs:surface.connect = </roboticArm/Looks/mainColor_yellow/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.80000746, 0.37257618, 0.00039553133)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "mainColor_green"
        {
            token outputs:surface.connect = </roboticArm/Looks/mainColor_green/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.00827229, 0.30541053, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
}

