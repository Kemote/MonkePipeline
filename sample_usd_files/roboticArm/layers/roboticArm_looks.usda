#usda 1.0
(
    framesPerSecond = 30
    timeCodesPerSecond = 30
)

def "roboticArm"
{
    def Scope "Looks"
    {
        def Material "secColor"
        {
            token outputs:surface.connect = </roboticArm/Looks/secColor/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15515924, 0.15515924, 0.15515924)
                token outputs:surface
            }
        }

        def Material "engineRed"
        {
            token outputs:surface.connect = </roboticArm/Looks/engineRed/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.80000746, 0, 0.0019808419)
                token outputs:surface
            }
        }

        def Material "welder_metal"
        {
            token outputs:surface.connect = </roboticArm/Looks/welder_metal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4886569, 0.4886569, 0.4886569)
                color3f inputs:diffuseColor.connect = </roboticArm/Looks/welder_metal/BaseColorTexture.outputs:rgb>
                token outputs:surface
            }

            def Shader "BaseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/welder.png@
                color3f outputs:rgb
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </roboticArm/Looks/rubber/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04020722, 0.04020722, 0.04020722)
                token outputs:surface
            }
        }

        def Material "mainColor_red"
        {
            token outputs:surface.connect = </roboticArm/Looks/mainColor_red/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.80000746, 0, 0.023635123)
                token outputs:surface
            }
        }

        def Material "mainColor_yellow"
        {
            token outputs:surface.connect = </roboticArm/Looks/mainColor_yellow/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.80000746, 0.37257618, 0.00039553133)
                token outputs:surface
            }
        }
    }
}

